{
  "name": "crm-monorepo",
  "private": true,
  "workspaces": ["services/*"],
  "scripts": {
    "install": "npm install",
    "dev": "concurrently \"npm --workspace @crm/auth-service run dev\" \"npm --workspace @crm/user-service run dev\"",
    "start": "concurrently \"npm --workspace @crm/auth-service run start\" \"npm --workspace @crm/user-service run start\"",
    "lint": "eslint \"services/**/*.{js,mjs,cjs}\" --quiet",
    "format": "prettier --write \"services/**/*.{js,json,md}\"",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "eslint": "^8.49.0",
    "prettier": "^2.8.8",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.6.0",
    "supertest": "^6.3.3"
  }
}
