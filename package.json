{
  "name": "crm-monorepo",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "bootstrap": "pnpm -w install",
    "dev": "concurrently \"pnpm --filter @crm/auth-service --parallel run dev\" \"pnpm --filter @crm/user-service --parallel run dev\"",
    "start": "concurrently \"pnpm --filter @crm/auth-service run start\" \"pnpm --filter @crm/user-service run start\"",
    "lint": "eslint \"services/**/*.{js,mjs,cjs}\" --quiet",
    "format": "prettier --write \"services/**/*.{js,json,md}\"",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "eslint": "^8.49.0",
    "prettier": "^2.8.8",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.6.0",
    "supertest": "^6.3.3"
  }
}